{
  "buildCommand": "npm install --prefix api && npm run build 2>/dev/null || true",
  "outputDirectory": "dist",
  "env": {
    "DATABASE_URL": "@database_url",
    "ADMIN_PASSWORD": "@admin_password"
  },
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}

